# Dependencies
node_modules/
package-lock.json
yarn.lock

# Build outputs
dist/
build/
*.tsbuildinfo
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
# Broad on purpose: every .env* is ignored, then .env.example files are
# re-included. The previous list matched only exact names, so a .env.prod or a
# .env.dev.bak would have sat untracked-but-committable, full of live secrets.
.env*
!.env.example
!apps/web/.env.local.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
playwright-report/
test-results/

# OS
Thumbs.db
.DS_Store

# Testing
coverage/
.nyc_output/

# Misc
.turbo/

# AI Docs
/docs/archive/

# Temp
.temp/

# Sensitive
*client_secret*.json
