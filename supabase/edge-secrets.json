    "GROW_SANDBOX_PAGE_CODE",
    "GROW_SANDBOX_TENANT_ID",
    "GROW_SANDBOX_USER_ID"
  ],
  "forbiddenInProdPatterns": [
    "_MOCK$"
  ],
  "platformProvided": [
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_DB_URL",
    "SUPABASE_PUBLISHABLE_KEYS",
