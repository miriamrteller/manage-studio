{
  "$comment": "Edge Function secret NAMES each Supabase project is expected to hold. Values never live in git. Checked by scripts/ci/check-edge-secret-names.mjs (deploy-dev, deploy-prod, drift-check). Supabase injects SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_DB_URL itself; they are ignored here.",
  "required": [
    "APP_URL",
    "CRON_SECRET",
    "PLATFORM_EMAIL_DOMAIN",
    "NOTIFICATION_FROM_EMAIL",
    "SEND_EMAIL_HOOK_SECRET",
    "WAIVER_HMAC_KEY_V1"
  ],
  "$commentRequiredOneOf": "Email needs ONE working transport: both Cloudflare names, or the Resend key (see _shared/email-client.ts).",
  "requiredOneOf": [
    [
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_EMAIL_API_TOKEN"
    ],
    [
      "RESEND_API_KEY"
    ]
  ],
  "$commentRequiredInProd": "Required on prod only (dev may use GROW_MOCK). GROW_API_BASE has no default in code: unset means Grow calls fail instead of reaching the sandbox.",
  "requiredInProd": [
    "GROW_API_BASE"
  ],
  "$commentSandboxValues": "Values that must never be set on prod. The Management API returns a SHA-256 digest per secret, so these are compared by digest (and by the word 'sandbox' when a raw value is returned).",
  "sandboxValuesForbiddenInProd": {
    "GROW_API_BASE": [
      "https://sandbox.meshulam.co.il/api/light/server/1.0",
      "https://sandbox.meshulam.co.il/api/light/server/1.0/",
      "https://sandbox.meshulam.co.il",
      "https://sandbox.meshulam.co.il/"
    ]
  },
  "optional": [
    "EMAIL_TRANSPORT",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_EMAIL_API_TOKEN",
    "APP_ROOT_DOMAIN",
    "RESEND_API_KEY",
    "WAIVER_HMAC_CURRENT_VERSION",
    "GROW_API_BASE",
    "GROW_NOTIFY_URL",
    "ICOUNT_NOTIFY_URL",
    "INVOICE4U_API_BASE",
    "INVOICE4U_NOTIFY_URL",
    "INVOICE4U_LIVE_VERIFY",
    "INVOICE4U_LIVE_REFUND",
    "ISSUE_DOCUMENT_URL",
    "GREEN_INVOICE_API_BASE",
    "GOOGLE_CALENDAR_CLIENT_ID",
    "GOOGLE_CALENDAR_CLIENT_SECRET",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_PHONE_NUMBER",
    "SELF_SERVE_SIGNUP_ENABLED",
    "TURNSTILE_SECRET_KEY",
    "TWILIO_VERIFY_SERVICE_SID",
    "TRANZILA_CALLBACK_SECRET",
    "TRANZILA_STO_TERMINAL_NAME",
    "CRM_INGEST_SECRET",
    "CRM_CONTACTS_ALLOWED_ORIGIN",
    "DEFAULT_TENANT_ID",
    "YPAY_LIVE_VERIFY",
    "ANTHROPIC_API_KEY",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_RELEASE",
    "TWILIO_INBOUND_WEBHOOK_URL",
    "CLOUDFLARE_SAAS_API_TOKEN",
    "CLOUDFLARE_SAAS_ZONE_ID",
    "CUSTOM_DOMAIN_CNAME_TARGET",
    "CUSTOM_DOMAIN_OWN_ZONES",
    "TURNSTILE_SITE_KEY",
    "TURNSTILE_HOSTNAME_LIMIT",
    "GITHUB_DISPATCH_TOKEN",
    "GITHUB_DISPATCH_REPO"
  ],
  "devOnly": [
    "SYNC_ISSUE_DOCUMENT_IN_DEV",
