# Security headers for the app Worker (Cloudflare static assets honors this
# file, Pages-style). Applied to every response on every tenant host.
#
# No Content-Security-Policy yet — a React SPA with Supabase and inline
# styles needs a curated policy, and a wrong one bricks the app. (Fonts are
# self-hosted via @fontsource, so no fonts.googleapis.com allowance needed.)
# Tracked as a hardening follow-up; add it deliberately, not here in passing.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Embeddable enquiry form (docs/plans/LEADS.md P1-B): the ONLY path a studio's
# own website may frame. Everything else keeps X-Frame-Options: DENY.
# deploy-web's smoke step checks both.
/embed/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors https:
