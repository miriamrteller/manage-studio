{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opalswift-app",
  "compatibility_date": "2026-07-21",

  // Vite build output. `not_found_handling` serves index.html for unmatched paths so
  // client-side routes (/login, /admin/...) survive a hard refresh.
  // The Worker (worker/index.ts) puts a studio's own icon into the HTML and answers /favicon.ico
  // for a studio host; every other request passes straight through to the assets. It needs
  // SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and APP_ROOT_DOMAIN: the deploy step passes the same
  // public values the browser bundle uses (.github/actions/web-release). Without them it does nothing.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Tenants are served from a wildcard, so this must be a ROUTE, not a Custom Domain —
  // Custom Domains match exactly and never match wildcards.
  //
  // Requires a proxied wildcard DNS record for *.opalswift.com (all Cloudflare plans).
  // Universal SSL covers the apex plus first-level subdomains, so no ACM is needed.
  //
  // `app.opalswift.com` is listed explicitly: it serves the tenant-less shell
  // (signup, post-payment onboarding, session handoff). It also matches the wildcard,
  // but naming it documents the intent and survives future route reshuffles.
  //
  // The apex (opalswift.com) is deliberately NOT here — that is the marketing site,
  // deployed from its own Worker.
  "routes": [
    { "pattern": "*.opalswift.com/*", "zone_name": "opalswift.com" },
    { "pattern": "app.opalswift.com/*", "zone_name": "opalswift.com" },

    // Studio custom domains on zones in this Cloudflare account (path A in
    // docs/deployment/CUSTOM-DOMAIN.md). Exact hostname only: never the apex or www,
    // which stay on the studio's own website.
    { "pattern": "app.creativeballetacademy.com/*", "zone_name": "creativeballetacademy.com" },

    // Self-serve custom domains (Cloudflare for SaaS on opalswift.com): a studio's
    // own address CNAMEs to proxy-fallback.opalswift.com and arrives on this zone
    // with its own Host, so only a catch-all route reaches this Worker (Cloudflare's
    // recommendation; per-hostname routes would need a deploy per studio).
    // BEFORE this ships, the apex must have a dashboard route with Worker = None
    // (opalswift.com/* → None): the more specific route wins and keeps the marketing
    // site (Pages) out of the app. www and every *.opalswift.com host already match
    // the more specific *.opalswift.com/* route above. docs/deployment/CUSTOM-DOMAIN.md.
    { "pattern": "*/*", "zone_name": "opalswift.com" }
  ],

  "observability": {
    "enabled": true
  }
}
