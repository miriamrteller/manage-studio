# =============================================================================
# Manage Studio — environment map (NO real secrets in git)
# =============================================================================
# Copy to repo-root `.env` (gitignored). Shell env wins over this file.
#
# | Layer              | Where values live                         | Sync command              |
# |--------------------|-------------------------------------------|---------------------------|
# | Local scripts/CLI  | Repo-root `.env`                          | (load-env.mjs)            |
# | Vite SPA (browser) | `apps/web/.env.local` + Workers build vars | rebuild (not redeploy)  |
# | Edge Functions     | Supabase Project → Edge secrets           | `pnpm secrets:edge` etc.  |
# | DB config / cron   | SQL `private.platform_config` rows        | smoke:cron / runbook      |
# | Tenant sender      | `tenants.contact_email` / `from_email` (DB)| Admin UI — NOT in .env    |
# | Per-tenant Grow    | Admin UI → bundled payments (DB encrypted)| NOT in .env               |
#
# Production: use a SEPARATE Supabase project + Cloudflare Workers production vars.
# SPA host is Cloudflare Workers static assets (NOT Pages — no wildcard custom domains).
# Never commit `.env`, `.env.*.local`, or supabase/.temp/*-secrets.env
#
# PROD HYGIENE (must NOT be true/set on production Edge secrets):
#   GROW_MOCK, ICOUNT_MOCK, INVOICE4U_MOCK, YPAY_MOCK, GOOGLE_CALENDAR_MOCK,
#   TRANZILA_MOCK, SYNC_ISSUE_DOCUMENT_IN_DEV
#   ⚠️ An UNSET mock flag selects the LIVE adapter. Only unset one once that
#      provider's credentials are saved and "Test connection" is green.
# PROD MUST SET: APP_URL=https://<your-app-origin>  (not localhost)
#
# The Postgres encryption key is NOT a GUC — hosted Supabase denies ALTER
# DATABASE SET on custom GUCs. It is a `private.platform_config` row, inserted
# by hand on prod (never seeded by a migration). See GO-LIVE-PLAN.md Phase B.
# =============================================================================

# --- Supabase (CLI / scripts) ------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public app URL (Edge: dunning links, GCal OAuth redirect_uri) -----------
# Local: http://localhost:5173
# Prod:  https://app.yourdomain.com
APP_URL=http://localhost:5173

# --- Cron (Edge secret + private.platform_config.cron_secret — same value) ---
CRON_SECRET=

# --- Email / auth hook (Edge — pnpm secrets:email / secrets:edge) ------------
RESEND_API_KEY=
# Fallback sending domain, REQUIRED. A tenant with no verified branded domain
# sends as <subdomain>@this — e.g. creativeballet@opalswift.com. Must be a
# Resend-verified domain. resolveTenantSender() throws when unset rather than
# guessing, because a hardcoded default here is how a non-existent domain once
# became the sender of record.
PLATFORM_EMAIL_DOMAIN=opalswift.com
# Platform-level sender for non-tenant mail. NOT a tenant override — tenant mail
# uses the tenant's own identity (contact_email / from_email in the DB).
NOTIFICATION_FROM_EMAIL=
# Dashboard → Auth → Hooks → Send Email → Generate Secret
SEND_EMAIL_HOOK_SECRET=

# --- Google Calendar (Edge — pnpm secrets:google-calendar) --------------------
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_MOCK=true   # local stub only — unset on prod

# --- Grow platform (Edge — NOT tenant merchant keys) -------------------------
# GROW_API_BASE=https://sandbox.meshulam.co.il/api/light/server/1.0
# GROW_NOTIFY_URL=   # optional; derived from SUPABASE_URL when omitted
# GROW_MOCK=true         # local/mock only — unset on prod / live sandbox E2E

# --- iCount platform (Edge — NOT tenant credentials) -------------------------
# Tenant company_id / page_id / api_token → Admin → Setup → Bundled payments
# ICOUNT_NOTIFY_URL=     # IPN URL sent to iCount; derived from SUPABASE_URL when omitted
# ICOUNT_MOCK=true       # local/mock only — UNSET selects the LIVE iCount adapter

# --- Invoice4U platform (Edge — NOT tenant API key) --------------------------
# Tenant API key + clearing company → Admin → Setup → Bundled payments
# INVOICE4U_API_BASE=https://apiqa.invoice4u.co.il/Services/ApiService.svc
# INVOICE4U_NOTIFY_URL=  # optional; derived from SUPABASE_URL when omitted
# INVOICE4U_MOCK=true    # Creative Ballet seed default; unset for live Invoice4U QA
# INVOICE4U_LIVE_VERIFY=true  # let verify-invoice4u-credentials reach the real API
#                             # (read-only auth ping) while charges stay mocked

# --- Tranzila platform (Edge) ------------------------------------------------
# TRANZILA_MOCK=true             # local/mock only — UNSET selects the LIVE adapter
# TRANZILA_STO_TERMINAL_NAME=    # platform-level standing-order terminal, NOT per-tenant

# --- Green Invoice (Edge) ----------------------------------------------------
# GREEN_INVOICE_API_BASE=https://api.greeninvoice.co.il/api/v1   # default when unset

# --- YPay platform (Edge — NOT tenant client_id/secret) ----------------------
# Tenant client_id + client_secret → Admin → Setup → Bundled payments (save_tenant_ypay_credentials)
# YPAY_API_BASE=https://ypay.co.il/api/v1   # default; sandbox uses same host + sandbox creds
# (no YPAY_NOTIFY_URL — YPay notify URL is derived, not configurable)
# YPAY_MOCK=true         # dev default; unset for live YPay
# YPAY_LIVE_VERIFY=true  # route verify-ypay-credentials to the real API while charges stay mocked
# NOTE: YPay has no tokenization/refund API — one-time + installments only, no unattended renewals.

# --- Document worker (Edge) --------------------------------------------------
# ISSUE_DOCUMENT_URL=
# SYNC_ISSUE_DOCUMENT_IN_DEV=true   # local only — unset on prod

# --- WhatsApp / Twilio (Edge — enable when shipping WA) ----------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_VERIFY_SERVICE_SID=

# --- Other Edge optional -----------------------------------------------------
# WAIVER_LINK_SECRET=
# Signing version for waiver links. Bump ONLY to rotate WAIVER_LINK_SECRET —
# already-issued links signed with the old version stop verifying.
# WAIVER_HMAC_CURRENT_VERSION=1
# ANTHROPIC_API_KEY=
# DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Grow sandbox E2E (Edge — DEV ONLY, never set on prod) -------------------
# Only read by supabase/functions/_shared/payments/grow/__tests__/gaps.test.ts,
# which skips itself unless all four are present. Real sandbox credentials.
# GROW_SANDBOX_USER_ID=
# GROW_SANDBOX_PAGE_CODE=
# GROW_SANDBOX_API_KEY=
# GROW_SANDBOX_TENANT_ID=

# --- Vite SPA (also set in apps/web/.env.local and the Workers build) --------
# Prefer apps/web/.env.local for local Vite; Workers Builds vars for deploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Root domain for tenant subdomains. Prod: opalswift.com → creativeballet.opalswift.com
VITE_APP_ROOT_DOMAIN=localhost:5173
# Dev-only fallback; ignored in production builds by design.
VITE_DEV_TENANT_SUBDOMAIN=creativeballet
# Self-serve signup wizard — off unless provision_tenant is re-granted to authenticated.
# VITE_ENABLE_SELF_SERVE_SIGNUP=false
# /admin/dev/finance-walkthrough — always on in DEV builds; this only exposes it
# in a production build. Leave unset on prod.
# VITE_ENABLE_FINANCE_WALKTHROUGH=false
# Legal footer links (optional until counsel pages exist)
# VITE_PRIVACY_POLICY_URL=https://yourdomain.com/privacy
# VITE_TERMS_URL=https://yourdomain.com/terms
# Sentry (optional — wire @sentry/react when ready)
# VITE_SENTRY_DSN=
# SENTRY_DSN=

# --- Playwright / e2e (optional) ---------------------------------------------
# PLAYWRIGHT_SEEDED_E2E=1
# PLAYWRIGHT_PARENT_E2E=1         # after pnpm seed:auth-parent + password login works
# PLAYWRIGHT_ADMIN_E2E=1          # after miriamrteller@gmail.com password login works
# PLAYWRIGHT_FINANCE_DEV=1
# E2E_PARENT_PASSWORD=devPassword123
# E2E_ADMIN_PASSWORD=devPassword123
