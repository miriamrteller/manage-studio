{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lead-email-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    // Non-secret: the crm-lead-ingest edge function on PROD Supabase.
    // Email Routing exists only on opalswift.com (prod), so this worker has
    // one environment. deploy-lead-email refuses any other project
    // (scripts/check-config.mjs).
    "CRM_INGEST_URL": "https://oogxajjanbyqhljxcmql.supabase.co/functions/v1/crm-lead-ingest"
  }
  // Secret (never committed): CRM_INGEST_SECRET. The deploy-lead-email
  // workflow can set it on the worker AND on prod Supabase in one run
  // (rotate_ingest_secret), so both sides always hold the same value.
}
